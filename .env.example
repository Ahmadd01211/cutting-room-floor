# Copy to .env and fill in. Never commit .env.

# --- backend -----------------------------------------------------------------
# "clickhouse" for a real server, "chdb" to run embedded with no server at all.
CRF_BACKEND=clickhouse

# --- ClickHouse --------------------------------------------------------------
# Local docker-compose defaults:
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=crf
CLICKHOUSE_PASSWORD=crf
CLICKHOUSE_SECURE=false

# ClickHouse Cloud instead — note port 8443 and secure=true:
# CLICKHOUSE_HOST=xxxxxxxx.region.provider.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_SECURE=true

# --- Google Cloud (agent layer, added next) ----------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
CRF_MODEL=gemini-3.5-flash

# --- demo scale --------------------------------------------------------------
CRF_VIEWERS=120
